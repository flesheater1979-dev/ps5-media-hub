{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agy-reminder.py\"",
            "timeout": 10,
            "statusMessage": "Checking agy..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-heredoc-escapes.py\"",
            "timeout": 10,
            "statusMessage": "Checking heredoc..."
          },
          {
            "type": "command",
            "command": "python3 -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.py\" pre",
            "timeout": 10,
            "statusMessage": "Checking rules..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.py\" post",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -X utf8 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.py\" edit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
